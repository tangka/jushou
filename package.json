{
  "name": "jushou",
  "description": "巨手：公众号内容运营系统",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "pnpm build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "operator:check": "node dist/check-operator-config.js",
    "docker": "node dist/operator-compose.js",
    "format": "biome check --write",
    "lint": "biome lint",
    "dev": "tsc && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "export": "node dist/export-to-obsidian.js",
    "enrich": "node dist/enrich-wechat-stats.js",
    "followers": "node dist/fetch-followers.js",
    "read-tendency": "node dist/fetch-read-tendency.js",
    "revenue": "node dist/fetch-revenue.js",
    "group-revenue": "node dist/group-revenue.js",
    "expense": "node dist/expense.js",
    "prune-drafts": "node dist/prune-drafts.js",
    "content-map": "node dist/build-content-map.js",
    "lint-vault": "node dist/lint-vault.js",
    "build-index": "node dist/build-article-data-index.js",
    "tag": "node dist/tag-articles.js",
    "business": "node dist/business-report.js",
    "suggest": "node dist/suggest.js",
    "login-check": "node dist/login-check.js",
    "draft": "node dist/generate-drafts.js",
    "check-prose": "node dist/check-wechat-prose.js",
    "publish-html": "node dist/build-publish-html.js",
    "upload-draft": "node dist/upload-wechat-draft.js",
    "verify-daily-drafts": "node dist/verify-daily-drafts.js",
    "verify-daily-publications": "node dist/verify-daily-publications.js",
    "channels": "node dist/fetch-channels-stats.js",
    "channels:revenue": "node dist/channel-revenue.js",
    "channels:probe": "node dist/channels/probe.js",
    "channels:import-capture": "node dist/channels/import-capture.js",
    "channels:publish-today": "node dist/channels/publish-today.js",
    "applet:login-check": "node dist/applets/login-check.js",
    "applet:fetch": "node dist/applets/fetch-revenue.js",
    "applet:import-capture": "node dist/applets/import-capture.js",
    "toutiao": "node dist/fetch-toutiao-stats.js",
    "toutiao:import-capture": "node dist/toutiao/import-capture.js",
    "toutiao:queue": "node dist/toutiao/queue.js",
    "toutiao:publish-next": "node dist/toutiao/publish-next.js",
    "collect": "node dist/collect.js",
    "reddit-collect": "node dist/reddit-collect.js",
    "sync": "node dist/sync.js",
    "sync:materials": "node dist/sync.js --materials-only",
    "sync:data": "node dist/sync.js --data-only",
    "scheduler": "node dist/scheduler.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.187",
    "@hono/node-server": "^1.13.7",
    "@openai/codex-sdk": "^0.144.1",
    "cheerio": "^1.1.2",
    "hono": "^4.6.14",
    "juice": "^11.0.3",
    "markdown-it": "^14.1.0",
    "puppeteer-core": "^25.1.0",
    "turndown": "^7.2.0",
    "undici": "^6.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
