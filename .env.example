# 兼容环境变量示例；推荐将个人值集中写入 operator.local.json。填写自己的账号信息。
# 代理服务地址(本项目 Hono 服务默认 3333;过渡期可指向原项目 wechat-article-exporter)
WECHAT_EXPORTER_BASE_URL=http://127.0.0.1:3333
# 读取 .env / .env.<账号> 的目录。容器里通常设为 /app-env,本机留空默认当前项目根。
# WECHAT_ENV_DIR=/absolute/path/to/env-dir

# 公众号搜索关键词 / 精确账号名(精确名决定输出子目录)
WECHAT_ACCOUNT_KEYWORD=your-account-keyword
WECHAT_ACCOUNT_EXACT=YourAccountName
WECHAT_CHANNEL_LABEL=YourChannelLabel
WECHAT_COVER_SCRIPT=cover.ts
# 视频号发布用 ego-browser 任务空间、页面可见账号文本和目标合集;每号单独配置,不要写进源码
# WECHAT_CHANNELS_EGO_TASK_SPACE=视频号-your-account
# WECHAT_CHANNELS_EGO_VERIFY_TEXT=YourVisibleChannelName
# WECHAT_CHANNELS_COLLECTION_NAME=YourDefaultCollection
# WECHAT_CHANNELS_DAILY_COLLECTION_NAME=YourDailyCollection
# WECHAT_CHANNELS_WEEKLY_COLLECTION_NAME=YourWeeklyCollection

# 账号差异配置:放在各自 .env / .env.<账号>,不要写进源码
# WECHAT_GOALS=短期:1000:1;中期:5000:1.2;远期:10000:1.5
# 常看列表广告已内置官方名称,WECHAT_AD_SLOT_NAMES 可按账号覆盖名称。
# WECHAT_AD_SLOT_NAMES=5156210557287366=留言区广告;9020229299926746=文中广告
# WECHAT_PUBLISH_THEME={"name":"默认正文主题","accent":"#0d0d0d","accentText":"#0d0d0d"}
# 账号正文默认整套风格;草稿 frontmatter 的 publish_style 可按篇覆盖
# WECHAT_PUBLISH_STYLE=grok-editorial

# Obsidian 库根目录;账号输出目录(留空则由库根 + 账号名推导)
# ⚠️ 别放在 iCloud 同步的 ~/Documents 下:iCloud 会锁住已同步的旧文件,脚本覆写/删除会 EPERM。用本地路径。
OBSIDIAN_VAULT=/absolute/path/to/wechat-vault
# WECHAT_ACCOUNT_ROOT=/absolute/path/to/wechat-vault/微信公众号/YourAccountName

# 登录态:login-state.json 路径 + KV cookie 存储根目录
# 过渡期指向原项目:.../wechat-article-exporter/artifacts/login-state.json 与 .../wechat-article-exporter/.data/kv
WECHAT_LOGIN_STATE=.data/login-state.json
NITRO_KV_BASE=.data/kv

# 公司级支出台账(跨公众号/小程序共享,首页只扣一次)
# COMPANY_DB=.data/company.db

# 多小程序配置:每个小程序使用独立登录态、Cookie KV 与收益库。
# APPLET_CONFIGS=[{"id":"demo-applet","name":"示例小程序","loginStatePath":".data/login-state-demo-applet.json","kvBase":".data/kv-demo-applet","dbPath":".data/stats-demo-applet.db"}]
# APPLET_ID=demo-applet

# 逐篇打微信后台的请求间隔(毫秒),避免限流;勿低于 1500
WECHAT_REQUEST_INTERVAL_MS=1500

# enrich 刷新窗口:默认只补抓近 30 天发布的文章;0=显式补全历史
WECHAT_REFRESH_DAYS=30
# 抓「用户分析」(粉丝)回看天数
WECHAT_STATS_DAYS=30
# scheduler 同步间隔(小时):每隔 N 小时跑一次 sync(已发布数据持续刷新)
SYNC_EVERY_HOURS=4

# 选题打标(ADR 0005):走 OpenRouter(OpenAI 兼容),默认路由 Anthropic Opus 4.8
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-4.8
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 仅给 OpenRouter 请求挂的 HTTP(S) 代理(Anthropic 区域受限时用;WeChat 不走代理)。回落 HTTPS_PROXY
# OPENROUTER_PROXY=http://127.0.0.1:7890

# Reddit 热帖监听(本地 Chrome + 代理访问 old.reddit;账号清单见 <账号>/reddit-watchlist.json)
# REDDIT_COLLECT_SKIP=1
# REDDIT_PROXY=http://127.0.0.1:7897
# REDDIT_MIN_SCORE=200
# REDDIT_CODEX_MODEL=gpt-5.6-luna
# REDDIT_DEFAULT_SUBS=OpenAI
# REDDIT_TITLE_DENY_KEYWORDS=politics,government,election,nsfw,jailbreak,政治,政府,越狱

# 失败通知(飞书 webhook,ADR 0004);勿提交真实值
# NOTIFY_WEBHOOK_URL=

# 微信官方 API(只用于上传到公众号后台草稿箱,不发布/群发);每个账号单独填在各自 .env.<账号>
# WECHAT_APPID=
# WECHAT_APPSECRET=
# WECHAT_DRAFT_AUTHOR=YourAccountName
# 封面素材类型默认 image;若微信后台要求旧式 thumb,可改为 thumb(但 thumb 尺寸限制更小)
# WECHAT_DRAFT_COVER_MATERIAL_TYPE=image

# 自动出稿:是否在正文末尾生成「# 评论区补充」模拟评论段。默认 0=不生成。
DRAFT_INCLUDE_COMMENT_SECTION=0
